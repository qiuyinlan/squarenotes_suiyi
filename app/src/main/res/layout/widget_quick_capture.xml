<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_capture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:contentDescription="新建笔记"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">
    <ImageView
        android:id="@+id/widget_quick_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_action"
        android:contentDescription="新建笔记"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_plus" />
    <TextView
        android:id="@+id/widget_quick_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="新建笔记"
        android:singleLine="true"
        android:textColor="#FF171717"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
